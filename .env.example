# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API to copy your URL and anon key
# 3. Go to SQL Editor and run the script in "supabase-schema.sql"
# 4. Paste your Project URL and anon public key below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=portfolio
